#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Spider.proto"
EXTERNPROTO "../protos/SlopeTerrain.proto"

WorldInfo {
  basicTimeStep 20
  contactProperties [
    ContactProperties {
      material1 "spider_foot"
      material2 "ground"
      coulombFriction [ 0.8 ]
      bounce 0
    }
  ]
}
Viewpoint {
  position 1.4 1.2 1.0
  orientation -0.42 0.56 0.72 2.25
  description "30 degree slope validation world"
}
Background { skyColor [ 0.08 0.10 0.14 ] }
DirectionalLight { direction -0.4 -0.6 -1 castShadows TRUE }
SlopeTerrain { angle 30 size 4 4 0.1 }
Spider { name "spider_slope_30" }
