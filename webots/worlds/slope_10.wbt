#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Spider.proto"
EXTERNPROTO "../protos/SlopeTerrain.proto"

WorldInfo {
  coordinateSystem "NUE"
  basicTimeStep 20
  contactProperties [
    ContactProperties {
      material1 "spider_foot"
      material2 "ground"
      coulombFriction [ 0.8 ]
      bounce 0
    }
  ]
}
Viewpoint {
  position 0.8 0.48 0.8
  orientation -0.377400 0.697553 0.609089 2.816821
  description "Spider validation world 10 deg"
  follow "spider_slope_10"
  followType "Tracking Shot"
  followSmoothness 0.15
}
Background { skyColor [ 0.18 0.22 0.30 ] }
DirectionalLight {
  ambientIntensity 0.6
  direction -0.4 -1 -0.3
  intensity 1.2
  castShadows TRUE
}
SlopeTerrain { angle 10 }
Spider { name "spider_slope_10" translation 0 0.049814553 0.017599999 rotation 0 1 0 0 }
