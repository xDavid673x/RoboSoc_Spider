#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Spider.proto"
EXTERNPROTO "../protos/SlopeTerrain.proto"

WorldInfo {
  coordinateSystem "NUE"
  basicTimeStep 20
  contactProperties [
    ContactProperties {
      material1 "spider_foot"
      material2 "ground"
      coulombFriction [ 0.8 ]
      bounce 0
    }
  ]
}
Viewpoint {
  position 1.35 1.15 0.95
  orientation -0.42 0.56 0.72 2.25
  description "20 degree slope validation world"
}
Background { skyColor [ 0.08 0.10 0.14 ] }
DirectionalLight { direction -0.4 -0.6 -1 castShadows TRUE }
SlopeTerrain { angle 20 }
Spider { name "spider_slope_20" }
